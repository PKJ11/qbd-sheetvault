# Copy to .env.local and fill in. Never commit .env.local.

# Database. Currently Neon (cloud):
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Optional later: a local PostgreSQL on the server (scripts\windows\create-database.ps1 prints the line).
DATABASE_URL=

# Session signing key: 64 random hex characters
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Office LAN over plain HTTP: allow the sign-in cookie without HTTPS. Remove when you add HTTPS.
COOKIE_SECURE=false

# ONLYOFFICE Docs Community (Excel editor)
#   ONLYOFFICE_URL         how users' browsers reach Document Server, e.g. http://qbd-server:8080
#   ONLYOFFICE_JWT_SECRET  same value as services.CoAuthoring.secret in
#                          C:\Program Files\ONLYOFFICE\DocumentServer\config\local.json
#   APP_INTERNAL_URL       how Document Server reaches SheetVault (same server: http://localhost:3000)
ONLYOFFICE_URL=http://localhost:8080
ONLYOFFICE_JWT_SECRET=
APP_INTERNAL_URL=http://localhost:3000
